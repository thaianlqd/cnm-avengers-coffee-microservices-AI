# Copy to data-platform/.env. This file configures analytics-api only.
# Chatbot credentials remain in the repository-root .env.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-flash-lite-latest
# Use Google's native generateContent API with responseJsonSchema.
GEMINI_API_STYLE=native
# V3.2 (optional) secondary Gemini credential for bounded credential failover only.
# Injected via docker-compose.data.yml; leave empty to disable. Never commit a real value.
DATA_ANALYST_GEMINI_SECONDARY_KEY=
# Gemini-only Data Analyst; prevents Groq fallback masking Gemini errors.
AI_AGENT_GROQ_FALLBACK=0
# V2.4 production single-shot policy. Unsafe values fail closed.
DATA_ANALYST_MAX_PROVIDER_CALLS_PER_TURN=3
DATA_ANALYST_ENABLE_CONTRACT_REPAIR=1
DATA_ANALYST_ONE_CLICK_ENABLED=1
DATA_ANALYST_ENABLE_MODEL_ESCALATION=0
DATA_ANALYST_ENABLE_PROVIDER_FALLBACK=0
DATA_ANALYST_ENABLE_POST_RESULT_SYNTHESIS=0
# Measured full offline index: 8,572 chars; whole provider context fits 24,000.
DATA_ANALYST_SEMANTIC_MANIFEST_MAX_CHARS=14000
DATA_ANALYST_ONE_SHOT_CONTEXT_MAX_CHARS=24000
AI_AGENT_SUPPORTING_OPERATIONS=3
DATA_ANALYST_DEEP_SUPPORTING_OPERATIONS=6
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Optional persistent private directory for sanitized audit reservations during DB outages.
# Owner must match the API process; mode0700. Records0600, <=1000events/4MiB.
# Unset = DB-only fail-closed. Never use /tmp or a shared/world-readable directory.
DATA_ANALYST_AUDIT_SPOOL_DIR=
# Optional OTel API spans, no-op without an operator-supplied SDK.
# This setting configures no exporter, collector or outbound telemetry.
DATA_ANALYST_OTEL_ENABLED=0
# Streaming rollout is independent of full-sync reconciliation. Standby performs no I/O.
# Enable only after reviewing stream contracts, writer roles and source clock assumptions.
DATA_PLATFORM_GOVERNED_STREAMING=0
