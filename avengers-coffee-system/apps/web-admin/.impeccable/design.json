  "narrative": {
    "northStar": "Clear enterprise operations with shadcn/ui",
    "overview": "Shared navy/sky Web Admin primitives with focused record detail cards. Customer red branding remains separate.",
    "keyCharacteristics": [
      "Navy navigation and stronger readable ink.",
      "Official shadcn source with Radix semantics.",
      "Clear record cards, restrained badges and responsive data geometry."
    ],
    "rules": [
      {
        "name": "The Canonical Logo Rule",
        "body": "Use `avengers-coffee-system/assets/branding/logo.svg`, the original black artwork, on light backgrounds and `logo-white.svg` from the same directory on dark backgrounds. Preserve the artwork and aspect ratio; app SVG copies and native PNGs are synchronized through `scripts/sync-brand.cjs`.",
        "section": "colors"
      },
      {
        "name": "One page heading",
        "body": "The shell owns the title; cards name information groups.",
        "section": "layout"
      },
      {
        "name": "Semantic emphasis",
        "body": "Use badges sparingly, green for confirmed active status and explicit save hover, red for destructive hover.",
        "section": "colors"
      },
      "Use StatusBadge for all status columns; preserve business labels and distinguish active, paused, pending and rejected states.",
      "Align detail action rows and modal footers with body content: 24px gutter, 18px in mobile dialogs, no extra gutter for nested footers.",
      "Map suggestions use the shared Radix popover with flexible two-line rows. Kiosk approval stays on the top action with the existing confirmation."
    ],
    "dos": [
      "Use shared primitives across roles.",
      "Preserve event contracts and permissions.",
      "Keep full chart labels in tooltips and data tables."
    ],
    "donts": [
      "Do not invent product statistics.",
      "Do not claim unperformed visual verification.",
      "Do not use decorative rainbow badges."
    ]
  }
