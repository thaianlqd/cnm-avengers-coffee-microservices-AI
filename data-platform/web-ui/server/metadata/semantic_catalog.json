      "description": "Danh mục món, phân loại thực đơn và hiệu suất bán sản phẩm.",
      "synonyms": ["món", "sản phẩm", "menu", "thực đơn", "đồ uống", "bánh", "bán chạy", "danh mục"],
      "tables": ["gold.top_products", "orders.chi_tiet_don_hang", "menu.san_pham", "menu.danh_muc", "orders.don_hang"],
      "dimensions": ["ten_san_pham", "ten_danh_muc", "kich_co"],
      "metrics": {
        "quantity_sold": {"business_name": "Số lượng bán", "expression": "SUM(so_luong)", "synonyms": ["bán chạy", "số lượng"]},
