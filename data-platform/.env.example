# Copy to data-platform/.env. This file configures analytics-api only.
# Chatbot credentials remain in the repository-root .env.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Use Google's OpenAI-compatible native tool API with Bearer authentication.
GEMINI_API_STYLE=openai
# Gemini-only Data Analyst; prevents Groq fallback masking Gemini errors.
AI_AGENT_GROQ_FALLBACK=0
GROQ_API_KEY=
ANTHROPIC_API_KEY=
