{
  "version": 1,
  "business_rules": [
    "Doanh thu hợp lệ mặc định chỉ gồm đơn HOAN_THANH và DANG_GIAO, trừ khi yêu cầu phân tích hủy đơn hoặc trạng thái.",
    "AOV bằng doanh thu hợp lệ chia cho số đơn hợp lệ.",
    "orders.don_hang.ngay_tao là thời điểm sự kiện đơn hàng.",
    "Không đưa dữ liệu định danh cá nhân hoặc giá trị mẫu PII vào ngữ cảnh LLM."
  ],
  "entities": [
    {
      "id": "orders",
      "business_name": "Đơn hàng và doanh thu",
      "role": "fact",
      "description": "Giao dịch đặt hàng và các chỉ số doanh thu toàn hệ thống.",
      "synonyms": ["đơn hàng", "giao dịch", "hóa đơn", "order", "doanh thu", "doanh số", "aov", "tăng trưởng"],
      "tables": ["orders.don_hang", "gold.revenue_daily", "gold.kpi_summary", "gold.order_status_distribution"],
