      },
      "relationships": [
        {"from": "orders.chi_tiet_don_hang.ma_san_pham", "to": "menu.san_pham.ma_san_pham", "source": "semantic_inferred"},
        {"from": "menu.san_pham.ma_danh_muc", "to": "menu.danh_muc.ma_danh_muc", "source": "physical"}
      ]
    },
    {
      "id": "stores",
      "business_name": "Chi nhánh và điểm bán",
