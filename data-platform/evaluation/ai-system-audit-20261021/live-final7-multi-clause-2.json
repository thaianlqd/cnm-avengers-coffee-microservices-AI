      "sql_by_query": {
        "q_ae84f5f3d9636a1edc94ff2b": "SELECT t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= DATE '2026-09-01') AND (t0.ngay_tao < DATE '2026-10-01') GROUP BY t1.thanh_pho ORDER BY \"revenue\" ASC NULLS LAST, \"city\" ASC NULLS LAST LIMIT 5",
        "q_1b122a28d654bbd97b6ff575": "WITH scoped_rows AS (SELECT t0.phuong_thuc_thanh_toan AS \"payment_method\", t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY t0.phuong_thuc_thanh_toan, t1.thanh_pho), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho ORDER BY \"revenue\" ASC, \"city\" ASC LIMIT 5) SELECT s.\"payment_method\", SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) GROUP BY s.\"payment_method\" ORDER BY \"payment_method\" ASC NULLS LAST LIMIT 50000",
        "q_3f3e1c651493d7450f15710f": "WITH scoped_rows AS (SELECT t1.ten_chi_nhanh AS \"store\", t1.thanh_pho AS \"city\", t1.ma_chi_nhanh AS \"store_id\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY t1.ten_chi_nhanh, t1.thanh_pho, t1.ma_chi_nhanh), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho ORDER BY \"revenue\" ASC, \"city\" ASC LIMIT 5) SELECT s.\"store\", s.\"store_id\", SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) GROUP BY s.\"store\", s.\"store_id\" ORDER BY \"store\" ASC NULLS LAST, \"store_id\" ASC NULLS LAST LIMIT 50000",
        "q_519a8537afcee1360a88ac59": "WITH scoped_rows AS (SELECT t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY t1.thanh_pho), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho ORDER BY \"revenue\" ASC, \"city\" ASC LIMIT 5) SELECT SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) LIMIT 1",
