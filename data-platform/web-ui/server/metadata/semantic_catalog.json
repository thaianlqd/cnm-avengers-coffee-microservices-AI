      "metrics": {
        "revenue": {"business_name": "Doanh thu", "expression": "SUM(tong_tien)", "synonyms": ["doanh thu", "doanh số", "sales"]},
        "order_count": {"business_name": "Số đơn", "expression": "COUNT(*)", "synonyms": ["số đơn", "đơn hàng"]},
        "aov": {"business_name": "Giá trị đơn trung bình", "expression": "SUM(tong_tien) / NULLIF(COUNT(*), 0)", "synonyms": ["aov", "giá trị đơn trung bình"]}
      }
    },
    {
      "id": "order_items",
      "business_name": "Chi tiết đơn hàng",
