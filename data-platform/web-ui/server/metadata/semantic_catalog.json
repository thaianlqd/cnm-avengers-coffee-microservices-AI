      },
      "relationships": [
        {"from": "orders.don_hang.co_so_ma", "to": "identity.chi_nhanh.ma_chi_nhanh", "source": "semantic_inferred"}
      ]
    },
    {
      "id": "customers",
      "business_name": "Khách hàng và hội viên",
      "role": "dimension",
      "description": "Phân khúc hội viên, loyalty và hành vi mua lặp lại ở mức tổng hợp.",
      "synonyms": ["khách hàng", "hội viên", "loyalty", "thành viên", "mua lặp lại", "tái mua", "rfm", "customer"],
      "tables": ["gold.customer_segments", "orders.don_hang", "identity.nguoi_dung", "identity.membership_config"],
