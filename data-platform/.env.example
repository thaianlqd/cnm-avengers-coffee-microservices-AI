# Copy to data-platform/.env. This file configures analytics-api only.
# Chatbot credentials remain in the repository-root .env.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash
# Use Google's OpenAI-compatible native tool API with Bearer authentication.
GEMINI_API_STYLE=openai
# Gemini-only Data Analyst; prevents Groq fallback masking Gemini errors.
AI_AGENT_GROQ_FALLBACK=0
# V2.4 production single-shot policy. Unsafe values fail closed.
DATA_ANALYST_MAX_PROVIDER_CALLS_PER_TURN=3
DATA_ANALYST_ENABLE_CONTRACT_REPAIR=1
DATA_ANALYST_ONE_CLICK_ENABLED=1
DATA_ANALYST_ENABLE_MODEL_ESCALATION=0
DATA_ANALYST_ENABLE_PROVIDER_FALLBACK=0
DATA_ANALYST_ENABLE_POST_RESULT_SYNTHESIS=0
# Measured full offline index: 8,572 chars; whole provider context fits 24,000.
DATA_ANALYST_SEMANTIC_MANIFEST_MAX_CHARS=10000
DATA_ANALYST_ONE_SHOT_CONTEXT_MAX_CHARS=24000
AI_AGENT_SUPPORTING_OPERATIONS=3
DATA_ANALYST_DEEP_SUPPORTING_OPERATIONS=6
GROQ_API_KEY=
ANTHROPIC_API_KEY=
