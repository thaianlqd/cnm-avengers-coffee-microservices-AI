      "sql_by_query": {
        "q_84285c0c3a48633193b73f66": "SELECT t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= DATE '2026-09-01') AND (t0.ngay_tao < DATE '2026-10-01') GROUP BY t1.thanh_pho ORDER BY \"revenue\" ASC NULLS LAST, \"city\" ASC NULLS LAST LIMIT 5",
        "q_1d18f72ca6c2102b54886980": "WITH scoped_rows AS (SELECT DATE_TRUNC('DAY', t0.ngay_tao) AS period, t1.loai_diem_ban AS \"store_type\", t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY DATE_TRUNC('DAY', t0.ngay_tao), t1.loai_diem_ban, t1.thanh_pho), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho ORDER BY \"revenue\" ASC, \"city\" ASC LIMIT 5) SELECT s.\"period\", s.\"store_type\", SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) GROUP BY s.\"period\", s.\"store_type\" ORDER BY \"period\" ASC NULLS LAST, \"store_type\" ASC NULLS LAST LIMIT 50000",
        "q_6e5af6b96f89b7a06371c004": "WITH scoped_rows AS (SELECT t1.ten_chi_nhanh AS \"store\", t1.thanh_pho AS \"city\", t1.ma_chi_nhanh AS \"store_id\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY t1.ten_chi_nhanh, t1.thanh_pho, t1.ma_chi_nhanh), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho ORDER BY \"revenue\" ASC, \"city\" ASC LIMIT 5) SELECT s.\"store\", s.\"store_id\", SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) GROUP BY s.\"store\", s.\"store_id\" ORDER BY \"store\" ASC NULLS LAST, \"store_id\" ASC NULLS LAST LIMIT 50000",
