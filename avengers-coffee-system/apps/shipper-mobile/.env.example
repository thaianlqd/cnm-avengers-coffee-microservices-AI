# URL kết nối tới API Gateway (Port 3000)
# Thay đổi IP này thành IP Wi-Fi/LAN của máy tính chạy server nếu IP thay đổi
EXPO_PUBLIC_API_URL=http://192.168.2.196:3000
EXPO_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here

# Native Android Google Maps, restricted by package + signing certificate.
# iOS uses Apple Maps. Expo Web uses the sandboxed Leaflet map.
GOOGLE_MAPS_ANDROID_API_KEY=
EXPO_PUBLIC_VIETMAP_API_KEY=

# Tùy chọn lưu trữ ảnh xác nhận đơn P.O.D lên Cloud (không lưu vào mã nguồn code)
# Nếu không cấu hình, hệ thống tự động nén Base64 Data URI lưu trực tiếp trong Database PostgreSQL
# EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset
# EXPO_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key
