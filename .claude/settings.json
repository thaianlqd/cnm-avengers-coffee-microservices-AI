{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "deny": [
      "Bash(git commit)",
      "Bash(git commit *)",
      "Bash(git -C * commit *)",
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(git reset)",
      "Bash(git reset *)",
      "Bash(git -C * reset *)",
      "Bash(git clean *)",
      "Bash(git -C * clean *)",
      "Bash(git stash)",
      "Bash(git stash *)",
      "Bash(git -C * stash *)",
      "Bash(git rebase *)",
      "Bash(git -C * rebase *)",
      "Bash(git restore *)",
      "Bash(git -C * restore *)",
      "Bash(git checkout -- *)",
      "Bash(git checkout .)",
      "Bash(docker compose down -v*)",
      "Bash(docker compose down --volumes*)",
      "Bash(docker compose * down -v*)",
      "Bash(docker compose * down --volumes*)",
      "Bash(docker-compose down -v*)",
      "Bash(docker-compose * down -v*)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune*)",
      "Bash(docker system prune*)",
      "Bash(docker compose config*)",
      "Bash(docker compose * config*)",
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(rm -Rf *)",
      "Bash(rm -r -f *)",
      "Bash(cat *.env)",
      "Bash(head *.env)",
      "Bash(tail *.env)",
      "Bash(less *.env)",
      "Bash(more *.env)",
      "Bash(grep * *.env)",
      "Bash(source *.env)",
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.production)",
      "Read(**/.env.development)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.production)",
      "Edit(**/.env.development)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)"
    ],
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(.venv/bin/python -m pytest *)",
      "Bash(python -m unittest *)",
      "Bash(docker run --rm --network none *)",
      "Bash(.claude/scripts/test-ai-offline.sh*)",
      "Bash(bash .claude/scripts/test-ai-offline.sh*)",
      "Bash(npm test*)",
      "Bash(npm run test*)",
      "Bash(npm run lint*)",
      "Bash(npm run typecheck*)",
      "Bash(npm run build*)",
      "Bash(npx eslint *)",
      "Bash(npx tsc *)",
      "Bash(npx jest *)",
      "Bash(node --test *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch --show-current)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(docker compose ps*)",
      "Bash(docker compose logs*)",
      "Bash(docker compose build*)",
      "Bash(docker compose up*)",
      "Bash(docker compose exec *)",
      "Bash(docker compose -f * ps*)",
      "Bash(docker compose -f * logs*)",
      "Bash(docker compose -f * build*)",
      "Bash(docker compose -f * up*)",
      "Bash(docker compose -f * exec *)",
      "Bash(ls*)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(find *)",
      "Bash(tree*)"
    ]
  }
}
