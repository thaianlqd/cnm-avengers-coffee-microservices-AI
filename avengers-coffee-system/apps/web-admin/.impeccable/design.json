      "css": ".ds-nav{padding:12px;background:var(--text-main,#142b3e);}.ds-nav-item{font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;cursor:pointer;transition:background-color 160ms ease,color 160ms ease,border-color 160ms ease;display:flex;align-items:center;gap:11px;width:100%;min-height:42px;padding:10px 12px;border:0;border-radius:6px;background:transparent;color:#d0d5de;font-size:13px;font-weight:500;line-height:1.5;text-align:left;}.ds-nav-item:hover{background:#202a39;color:#fff;}.ds-nav-item[aria-current=\"page\"]{background:var(--primary,#16354d);color:#fff;}.ds-nav-item:focus-visible{outline:2px solid var(--primary,#16354d);outline-offset:3px;}.ds-nav-dot{width:4px;height:4px;margin-left:auto;border-radius:50%;background:#fff;}@media(prefers-reduced-motion:reduce){.ds-nav,.ds-nav-dot,.ds-nav-item{animation:none!important;transition:none!important;scroll-behavior:auto!important;}}"
