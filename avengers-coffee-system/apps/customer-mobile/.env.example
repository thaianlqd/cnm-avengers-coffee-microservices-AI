# Values are embedded in the app bundle; never put a Google client secret here.
EXPO_PUBLIC_API_URL=https://api.example.com
EXPO_PUBLIC_SOCKET_URL=https://chat.example.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Android OAuth client is bound to com.avengers.coffee.customer + signing SHA-1.
# Set CUSTOMER_MOBILE_GOOGLE_ANDROID_CLIENT_ID in backend deployment env too.

# Public reCAPTCHA v2 checkbox site key used by web.
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=

# Native Android Google Maps: restrict by Android package + signing certificate.
# Build-time configuration, not an EXPO_PUBLIC variable. iOS uses Apple Maps.
GOOGLE_MAPS_ANDROID_API_KEY=
# Routing: VietMap motorcycle first; OSRM driving fallback when unavailable.
EXPO_PUBLIC_VIETMAP_API_KEY=
# EXPO_PUBLIC_SOCKET_URL must reach order-service (/tracking-stomp and /notifications).
