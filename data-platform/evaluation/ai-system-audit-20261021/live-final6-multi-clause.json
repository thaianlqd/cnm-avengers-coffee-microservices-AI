      "sql_by_query": {
        "q_00aa56c9544c694a4b8fe56c": "SELECT t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= DATE '2026-09-01') AND (t0.ngay_tao < DATE '2026-10-01') GROUP BY t1.thanh_pho ORDER BY \"revenue\" ASC NULLS LAST, \"city\" ASC NULLS LAST LIMIT 5",
        "q_b8084be1e3ae16bb81ee4976": "SELECT t1.thanh_pho AS \"city\", t0.phuong_thuc_thanh_toan AS \"payment_method\", t1.ten_chi_nhanh AS \"store\", t1.ma_chi_nhanh AS \"store_id\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= DATE '2026-09-01') AND (t0.ngay_tao < DATE '2026-10-01') GROUP BY t1.thanh_pho, t0.phuong_thuc_thanh_toan, t1.ten_chi_nhanh, t1.ma_chi_nhanh ORDER BY \"revenue\" DESC NULLS LAST, \"city\" ASC NULLS LAST, \"payment_method\" ASC NULLS LAST, \"store\" ASC NULLS LAST, \"store_id\" ASC NULLS LAST LIMIT 5",
        "q_380fdcb57b2691ba3086fb93": "WITH scoped_rows AS (SELECT DATE_TRUNC('DAY', t0.ngay_tao) AS period, t1.loai_diem_ban AS \"store_type\", t1.thanh_pho AS \"city\", t0.phuong_thuc_thanh_toan AS \"payment_method\", t1.ten_chi_nhanh AS \"store\", t1.ma_chi_nhanh AS \"store_id\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY DATE_TRUNC('DAY', t0.ngay_tao), t1.loai_diem_ban, t1.thanh_pho, t0.phuong_thuc_thanh_toan, t1.ten_chi_nhanh, t1.ma_chi_nhanh), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", rc_t0.phuong_thuc_thanh_toan AS \"payment_method\", rc_t1.ten_chi_nhanh AS \"store\", rc_t1.ma_chi_nhanh AS \"store_id\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho, rc_t0.phuong_thuc_thanh_toan, rc_t1.ten_chi_nhanh, rc_t1.ma_chi_nhanh ORDER BY \"revenue\" DESC NULLS LAST, \"city\" ASC, \"payment_method\" ASC, \"store\" ASC, \"store_id\" ASC LIMIT 5) SELECT s.\"period\", s.\"store_type\", SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) AND (s.\"payment_method\" = r.\"payment_method\" OR (s.\"payment_method\" IS NULL AND r.\"payment_method\" IS NULL)) AND (s.\"store\" = r.\"store\" OR (s.\"store\" IS NULL AND r.\"store\" IS NULL)) AND (s.\"store_id\" = r.\"store_id\" OR (s.\"store_id\" IS NULL AND r.\"store_id\" IS NULL)) GROUP BY s.\"period\", s.\"store_type\" ORDER BY \"period\" ASC NULLS LAST, \"store_type\" ASC NULLS LAST LIMIT 50000",
        "q_af27c95380796d3a6603bc2f": "SELECT t1.thanh_pho AS \"city\", t0.loai_don_hang AS \"order_type\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= DATE '2026-09-01') AND (t0.ngay_tao < DATE '2026-10-01') GROUP BY t1.thanh_pho, t0.loai_don_hang ORDER BY \"city\" ASC NULLS LAST, \"order_type\" ASC NULLS LAST LIMIT 50001",
        "q_c551db73f57b79989bb47245": "WITH scoped_rows AS (SELECT DATE_TRUNC('DAY', t0.ngay_tao) AS period, t1.thanh_pho AS \"city\", SUM(t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS t0 JOIN silver.chi_nhanh AS t1 ON t0.co_so_ma = t1.ma_chi_nhanh WHERE (t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY DATE_TRUNC('DAY', t0.ngay_tao), t1.thanh_pho), ranked_cohort AS (SELECT rc_t1.thanh_pho AS \"city\", SUM(rc_t0.tong_tien) AS \"revenue\" FROM silver.don_hang AS rc_t0 JOIN silver.chi_nhanh AS rc_t1 ON rc_t0.co_so_ma = rc_t1.ma_chi_nhanh WHERE (rc_t0.trang_thai_don_hang IN ('HOAN_THANH', 'DANG_GIAO')) AND (rc_t0.ngay_tao >= CAST('2026-09-01' AS DATE)) AND (rc_t0.ngay_tao < CAST('2026-10-01' AS DATE)) GROUP BY rc_t1.thanh_pho ORDER BY \"revenue\" ASC, \"city\" ASC LIMIT 5) SELECT s.\"period\", SUM(s.\"revenue\") AS \"revenue\" FROM scoped_rows AS s JOIN ranked_cohort AS r ON (s.\"city\" = r.\"city\" OR (s.\"city\" IS NULL AND r.\"city\" IS NULL)) GROUP BY s.\"period\" ORDER BY \"period\" ASC NULLS LAST LIMIT 50000",
