      },
      "relationships": [
        {"from": "orders.chi_tiet_don_hang.ma_don_hang", "to": "orders.don_hang.ma_don_hang", "source": "physical"}
      ]
    },
    {
      "id": "products",
      "business_name": "Sản phẩm và thực đơn",
