        "lifetime_value": {"business_name": "Giá trị vòng đời", "expression": "SUM(tong_tien) theo khách", "synonyms": ["ltv", "chi tiêu"]}
      },
      "relationships": [
        {"from": "orders.don_hang.ma_nguoi_dung", "to": "identity.nguoi_dung.ma_nguoi_dung", "source": "semantic_inferred"}
      ]
    },
    {
      "id": "payments",
      "business_name": "Thanh toán",
      "role": "fact_detail",
      "description": "Cơ cấu phương thức, cổng và trạng thái thanh toán.",
      "synonyms": ["thanh toán", "momo", "vnpay", "qr", "tiền mặt", "chuyển khoản", "payment"],
      "tables": ["gold.payment_methods_distribution", "orders.don_hang", "orders.giao_dich_thanh_toan"],
      "dimensions": ["phuong_thuc_thanh_toan", "cong_thanh_toan", "trang_thai_thanh_toan"],
      "metrics": {
        "payment_count": {"business_name": "Số giao dịch", "expression": "COUNT(*)", "synonyms": ["số giao dịch"]},
        "payment_revenue": {"business_name": "Doanh thu theo thanh toán", "expression": "SUM(tong_tien)", "synonyms": ["doanh thu"]}
      },
      "relationships": [
        {"from": "orders.giao_dich_thanh_toan.ma_don_hang", "to": "orders.don_hang.ma_don_hang", "source": "physical"}
      ]
    },
    {
      "id": "hourly",
      "business_name": "Khung giờ bán hàng",
      "role": "derived",
      "description": "Mật độ đơn và doanh thu theo giờ phát sinh đơn.",
      "synonyms": ["khung giờ", "giờ cao điểm", "đông nhất", "theo giờ", "cao điểm"],
      "tables": ["orders.don_hang"],
      "dimensions": ["EXTRACT(HOUR FROM ngay_tao)"],
      "metrics": {
        "hourly_orders": {"business_name": "Số đơn theo giờ", "expression": "COUNT(*)", "synonyms": ["đông nhất"]}
      }
    },
    {
      "id": "delivery",
      "business_name": "Giao hàng và shipper",
      "role": "fact_detail",
      "description": "Hiệu suất tài xế, trạng thái giao và thời gian giao hàng.",
      "synonyms": ["giao hàng", "shipper", "tài xế", "delivery", "thời gian giao", "giao thành công"],
      "tables": ["gold.shipper_performance", "orders.shipper_delivery", "orders.delivery_tracking", "orders.shipper", "orders.don_hang"],
      "dimensions": ["status", "delivery_mode", "delivery_method"],
      "metrics": {
        "delivery_count": {"business_name": "Số lượt giao", "expression": "COUNT(*)", "synonyms": ["lượt giao"]},
        "delivery_time": {"business_name": "Thời gian giao trung bình", "expression": "AVG(delivered_at - assigned_at)", "synonyms": ["thời gian giao"]},
        "delivery_success_rate": {"business_name": "Tỷ lệ giao thành công", "expression": "giao thành công / tổng lượt giao", "synonyms": ["tỷ lệ thành công"]}
      },
      "relationships": [
        {"from": "orders.shipper_delivery.ma_don_hang", "to": "orders.don_hang.ma_don_hang", "source": "semantic_inferred"}
      ]
    }
